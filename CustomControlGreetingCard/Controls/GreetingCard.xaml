<UserControl x:Class="CustomControlGreetingCard.Controls.GreetingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControlGreetingCard.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="15" Padding="15" Margin="10">
        <StackPanel>
            <!-- We bind the TextBlock to our CardTitle dependency property -->
            <TextBlock Text="{Binding CardTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       Foreground="White" 
                       FontSize="16" 
                       FontWeight="Bold"/>

            <TextBlock Text="This is static text inside our reusable custom control." 
                       Foreground="#A1A1A6" 
                       FontSize="12" 
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
